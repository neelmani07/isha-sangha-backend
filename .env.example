# Copy to your shell profile or run before bootRun:
#   export $(grep -v '^#' .env.example | xargs)

DB_URL=jdbc:postgresql://localhost:5432/isha_world

# macOS Homebrew PostgreSQL: use your macOS username (echo $USER), often with no password.
DB_USERNAME=pws
DB_PASSWORD=

# Linux / Docker PostgreSQL: usually postgres/postgres
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

JWT_SECRET=change-me-in-local-dev
FRONTEND_ORIGIN=http://localhost:5173

# Public user sign-in
GOOGLE_CLIENT_ID=
# SMTP for email sign-in codes (Amazon SES, Brevo, Gmail...). Unset in dev: codes are printed in the console.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
OTP_FROM_EMAIL=

# Site identity (shown on every page and the Donate page)
SITE_NAME=Isha Sangha
SITE_CONTACT_EMAIL=hello@example.org
ORG_LEGAL_NAME=
ORG_REGISTRATION_NUMBER=
ORG_TAX_EXEMPTION=
ORG_ADDRESS=
